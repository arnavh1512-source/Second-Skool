# ============================================================================
# Second Skool — environment variables
# Copy to `.env.local` and fill in. Never commit real values.
# ============================================================================

# --- Supabase (required) ----------------------------------------------------
# Project URL + keys from your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by /api/push and the developer console.
# NEVER expose to the client and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push / VAPID (required for notifications) ---------------------------
# Generate a keypair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The public key is also needed in the browser to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contact URI sent to push services (defaults to mailto:admin@secondskool.app).
VAPID_SUBJECT=mailto:you@example.com

# --- Rate limiting (optional, recommended in production) ---------------------
# An Upstash Redis REST endpoint, so the API rate limits count one caller once
# across every serverless instance. Without these two the limit still works but
# is counted per instance, which means the real ceiling is the configured limit
# multiplied by however many instances Vercel happened to start. Nothing warns
# you about that, so if the app is live and these are blank, that is the state
# it is in. Create a database at upstash.com and copy the REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site URL (recommended) -------------------------------------------------
# Absolute base for og:image / manifest / canonical. On Vercel this falls back
# to the production domain automatically; set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=
